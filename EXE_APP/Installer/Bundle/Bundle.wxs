<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:bal="http://wixtoolset.org/schemas/v4/wxs/bal"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">
  <Bundle Name="Neon Swarm Setup"
          Manufacturer="Luis Apps Inc."
          Version="$(var.BundleVersion)"
          UpgradeCode="D3F2A20A-9D7B-4AF1-B1AD-75F29C93C4E6">
    <util:RegistrySearch
        Id="WebView2MachineSearch"
        Variable="WebView2MachineInstalled"
        Root="HKLM"
        Key="SOFTWARE\WOW6432Node\Microsoft\EdgeUpdate\Clients\{F3017226-FE2A-4295-8BDF-00C3A9A7E4C5}"
        Value="pv"
        Result="exists"
        Bitness="always64" />
    <util:RegistrySearch
        Id="WebView2UserSearch"
        Variable="WebView2UserInstalled"
        Root="HKCU"
        Key="Software\Microsoft\EdgeUpdate\Clients\{F3017226-FE2A-4295-8BDF-00C3A9A7E4C5}"
        Value="pv"
        Result="exists"
        Bitness="always64" />

    <BootstrapperApplication>
      <bal:WixStandardBootstrapperApplication
          Theme="hyperlinkLicense"
          LicenseUrl="https://github.com/luisdiko14-lab/Cool.game/blob/main/LICENSE"
          ShowVersion="yes" />
    </BootstrapperApplication>
    <Chain>
      <ExePackage Id="WebView2Evergreen"
                  SourceFile="$(var.WebView2Installer)"
                  InstallArguments="/silent /install"
                  DetectCondition="WebView2MachineInstalled OR WebView2UserInstalled"
                  Permanent="yes"
                  Vital="yes" />
      <MsiPackage Id="NeonSwarmMsi"
                  SourceFile="$(var.MsiPath)"
                  Vital="yes" />
    </Chain>
  </Bundle>
</Wix>
